datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                    String                 @id @default(uuid())
  email                 String                 @unique
  passwordHash          String
  name                  String
  role                  String                 @default("member")
  department            String?
  avatarUrl             String?
  skills                String                 @default("[]")
  totalXp               Int                    @default(0)
  currentLevel          String                 @default("Newcomer")
  portfolioPublic       Boolean                @default(true)
  createdAt             DateTime               @default(now())
  auditLogs             AuditLog[]
  clarificationMessages ClarificationMessage[]
  reviewedContributions Contribution[]         @relation("ReviewerContributions")
  contributions         Contribution[]         @relation("UserContributions")
  userBadges            UserBadge[]
}

model Category {
  id            String         @id @default(uuid())
  name          String         @unique
  baseXp        Int
  colorHex      String
  isActive      Boolean        @default(true)
  contributions Contribution[]
}

model Contribution {
  id                    String                 @id @default(uuid())
  userId                String
  categoryId            String
  title                 String
  description           String
  projectEventName      String
  evidenceType          String
  evidenceUrl           String
  status                String                 @default("pending")
  pointsAwarded         Int                    @default(0)
  reviewerId            String?
  reviewerNotes         String?
  createdAt             DateTime               @default(now())
  verifiedAt            DateTime?
  clarificationMessages ClarificationMessage[]
  category              Category               @relation(fields: [categoryId], references: [id])
  reviewer              User?                  @relation("ReviewerContributions", fields: [reviewerId], references: [id])
  user                  User                   @relation("UserContributions", fields: [userId], references: [id], onDelete: Cascade)
}

model ClarificationMessage {
  id             String       @id @default(uuid())
  contributionId String
  senderId       String
  message        String
  createdAt      DateTime     @default(now())
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  contribution   Contribution @relation(fields: [contributionId], references: [id], onDelete: Cascade)
}

model Badge {
  id                String      @id @default(uuid())
  name              String
  description       String
  iconKey           String
  criteriaType      String
  criteriaThreshold Int
  userBadges        UserBadge[]
}

model UserBadge {
  id         String   @id @default(uuid())
  userId     String
  badgeId    String
  unlockedAt DateTime @default(now())
  badge      Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
}

model AuditLog {
  id           String   @id @default(uuid())
  actorId      String
  action       String
  targetEntity String
  targetId     String?
  payload      String?
  createdAt    DateTime @default(now())
  actor        User     @relation(fields: [actorId], references: [id], onDelete: Cascade)
}

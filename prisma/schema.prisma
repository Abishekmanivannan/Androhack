datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id              String      @id @default(uuid())
  email           String      @unique
  passwordHash    String
  name            String
  role            String      @default("member") // "member", "coordinator", "admin"
  department      String?
  avatarUrl       String?
  skills          String      @default("[]") // JSON string array of skills
  totalXp         Int         @default(0)
  currentLevel    String      @default("Newcomer")
  portfolioPublic Boolean     @default(true)
  createdAt       DateTime    @default(now())

  contributions         Contribution[]         @relation("UserContributions")
  reviewedContributions Contribution[]         @relation("ReviewerContributions")
  userBadges            UserBadge[]
  clarificationMessages ClarificationMessage[]
  auditLogs             AuditLog[]
}

model Category {
  id          String   @id @default(uuid())
  name        String   @unique
  baseXp      Int
  colorHex    String
  isActive    Boolean  @default(true)

  contributions Contribution[]
}

model Contribution {
  id               String   @id @default(uuid())
  userId           String
  categoryId       String
  title            String
  description      String
  projectEventName String
  evidenceType     String   // "url", "file", "github"
  evidenceUrl      String
  status           String   @default("pending") // "draft", "pending", "verified", "rejected", "clarification"
  pointsAwarded    Int      @default(0)
  reviewerId       String?
  reviewerNotes    String?
  createdAt        DateTime @default(now())
  verifiedAt       DateTime?

  user                  User                   @relation("UserContributions", fields: [userId], references: [id], onDelete: Cascade)
  reviewer              User?                  @relation("ReviewerContributions", fields: [reviewerId], references: [id])
  category              Category               @relation(fields: [categoryId], references: [id])
  clarificationMessages ClarificationMessage[]
}

model ClarificationMessage {
  id             String   @id @default(uuid())
  contributionId String
  senderId       String
  message        String
  createdAt      DateTime @default(now())

  contribution Contribution @relation(fields: [contributionId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
}

model Badge {
  id                String   @id @default(uuid())
  name              String
  description       String
  iconKey           String
  criteriaType      String   // "xp_threshold", "count_category", "streak"
  criteriaThreshold Int

  userBadges UserBadge[]
}

model UserBadge {
  id         String   @id @default(uuid())
  userId     String
  badgeId    String
  unlockedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge Badge @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
}

model AuditLog {
  id           String   @id @default(uuid())
  actorId      String
  action       String
  targetEntity String
  targetId     String?
  payload      String?  // JSON stringified payload
  createdAt    DateTime @default(now())

  actor User @relation(fields: [actorId], references: [id], onDelete: Cascade)
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id              String   @id @default(uuid())
  email           String   @unique
  passwordHash    String   @map("password_hash")
  name            String
  role            String   @default("member")
  department      String?
  avatarUrl       String?  @map("avatar_url")
  skills          String[] @default([])
  totalXp         Int      @default(0) @map("total_xp")
  currentLevel    String   @default("Tier 1: Newcomer") @map("current_level")
  portfolioPublic Boolean  @default(true) @map("portfolio_public")
  createdAt       DateTime @default(now()) @map("created_at")

  contributions         Contribution[]         @relation("UserContributions")
  reviewedContributions Contribution[]         @relation("ReviewerContributions")
  userBadges            UserBadge[]
  clarificationMessages ClarificationMessage[]
  xpTransactions        XpTransaction[]
  projectMembers        ProjectMember[]
  eventParticipants     EventParticipant[]
  streak                UserStreak?
  challengeParticipants ChallengeParticipant[]
  userAchievements      UserAchievement[]
  notifications         Notification[]
  announcements         Announcement[]
  auditLogs             AuditLog[]             @relation("AuditActor")

  @@map("profiles")
}

model Category {
  id       String  @id @default(uuid())
  name     String  @unique
  baseXp   Int     @map("base_xp")
  colorHex String  @map("color_hex")
  isActive Boolean @default(true) @map("is_active")

  contributions Contribution[]
  events        Event[]
  challenges    Challenge[]

  @@map("contribution_categories")
}

model Contribution {
  id               String    @id @default(uuid())
  userId           String    @map("user_id")
  categoryId       String    @map("category_id")
  projectId        String?   @map("project_id")
  eventId          String?   @map("event_id")
  title            String
  description      String
  projectEventName String?   @map("project_event_name")
  evidenceType     String?   @map("evidence_type")
  evidenceUrl      String?   @map("evidence_url")
  status           String    @default("pending")
  reviewerId       String?   @map("reviewer_id")
  reviewerNotes    String?   @map("reviewer_notes")
  createdAt        DateTime  @default(now()) @map("created_at")
  verifiedAt       DateTime? @map("verified_at")

  user                  User                   @relation("UserContributions", fields: [userId], references: [id], onDelete: Cascade)
  reviewer              User?                  @relation("ReviewerContributions", fields: [reviewerId], references: [id])
  category              Category               @relation(fields: [categoryId], references: [id])
  project               Project?               @relation(fields: [projectId], references: [id])
  event                 Event?                 @relation(fields: [eventId], references: [id])
  clarificationMessages ClarificationMessage[]
  xpTransaction         XpTransaction?

  @@map("contributions")
}

model ClarificationMessage {
  id             String   @id @default(uuid())
  contributionId String   @map("contribution_id")
  senderId       String   @map("sender_id")
  message        String
  createdAt      DateTime @default(now()) @map("created_at")

  contribution Contribution @relation(fields: [contributionId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@map("clarification_messages")
}

model Badge {
  id                String @id @default(uuid())
  name              String
  description       String
  iconKey           String @map("icon_key")
  criteriaType      String @map("criteria_type")
  criteriaThreshold Int    @map("criteria_threshold")

  userBadges UserBadge[]

  @@map("badges")
}

model UserBadge {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  badgeId    String   @map("badge_id")
  unlockedAt DateTime @default(now()) @map("unlocked_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge Badge @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
  @@map("user_badges")
}

model AuditLog {
  id           String   @id @default(uuid())
  actorId      String   @map("actor_id")
  action       String
  targetEntity String   @map("target_entity")
  targetId     String?  @map("target_id")
  payload      String?
  createdAt    DateTime @default(now()) @map("created_at")

  actor User @relation("AuditActor", fields: [actorId], references: [id], onDelete: Cascade)

  @@map("audit_logs")
}

model XpTransaction {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  amount         Int
  reason         String
  contributionId String?  @unique @map("contribution_id")
  createdAt      DateTime @default(now()) @map("created_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  contribution Contribution? @relation(fields: [contributionId], references: [id])

  @@map("xp_transactions")
}

model Project {
  id             String          @id @default(uuid())
  name           String
  description    String
  status         String          @default("active")
  githubUrl      String?         @map("github_url")
  requiredSkills String[]        @default([]) @map("required_skills")
  createdAt      DateTime        @default(now()) @map("created_at")

  members       ProjectMember[]
  contributions Contribution[]

  @@map("projects")
}

model ProjectMember {
  id        String   @id @default(uuid())
  projectId String   @map("project_id")
  userId    String   @map("user_id")
  role      String   @default("contributor")
  joinedAt  DateTime @default(now()) @map("joined_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@map("project_members")
}

model Event {
  id          String             @id @default(uuid())
  title       String
  description String
  eventDate   DateTime           @map("event_date")
  location    String?
  categoryId  String?            @map("category_id")
  baseXp      Int                @default(40) @map("base_xp")
  status      String             @default("upcoming")
  createdAt   DateTime           @default(now()) @map("created_at")

  category     Category?          @relation(fields: [categoryId], references: [id])
  participants EventParticipant[]
  contributions Contribution[]

  @@map("events")
}

model EventParticipant {
  id          String    @id @default(uuid())
  eventId     String    @map("event_id")
  userId      String    @map("user_id")
  status      String    @default("registered")
  checkedInAt DateTime? @map("checked_in_at")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@map("event_participants")
}

model UserStreak {
  id             String    @id @default(uuid())
  userId         String    @unique @map("user_id")
  currentStreak  Int       @default(0) @map("current_streak")
  longestStreak  Int       @default(0) @map("longest_streak")
  lastActivityAt DateTime? @map("last_activity_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_streaks")
}

model Challenge {
  id          String                 @id @default(uuid())
  title       String
  description String
  categoryId  String?                @map("category_id")
  targetCount Int                    @default(1) @map("target_count")
  targetXp    Int                    @default(100) @map("target_xp")
  bonusXp     Int                    @default(50) @map("bonus_xp")
  startDate   DateTime               @map("start_date")
  endDate     DateTime               @map("end_date")
  isActive    Boolean                @default(true) @map("is_active")

  category     Category?              @relation(fields: [categoryId], references: [id])
  participants ChallengeParticipant[]

  @@map("challenges")
}

model ChallengeParticipant {
  id           String    @id @default(uuid())
  challengeId  String    @map("challenge_id")
  userId       String    @map("user_id")
  currentCount Int       @default(0) @map("current_count")
  currentXp    Int       @default(0) @map("current_xp")
  status       String    @default("in_progress")
  completedAt  DateTime? @map("completed_at")

  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([challengeId, userId])
  @@map("challenge_participants")
}

model Achievement {
  id          String            @id @default(uuid())
  title       String
  description String
  iconKey     String            @map("icon_key")
  bonusXp     Int               @default(25) @map("bonus_xp")

  userAchievements UserAchievement[]

  @@map("achievements")
}

model UserAchievement {
  id            String      @id @default(uuid())
  userId        String      @map("user_id")
  achievementId String      @map("achievement_id")
  unlockedAt    DateTime    @default(now()) @map("unlocked_at")

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@map("user_achievements")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  type      String
  title     String
  message   String
  linkUrl   String?  @map("link_url")
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model Announcement {
  id         String   @id @default(uuid())
  authorId   String   @map("author_id")
  title      String
  content    String
  targetRole String   @default("all") @map("target_role")
  isPinned   Boolean  @default(false) @map("is_pinned")
  createdAt  DateTime @default(now()) @map("created_at")

  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@map("announcements")
}

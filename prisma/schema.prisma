datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id              String      @id @default(uuid())
  email           String      @unique
  passwordHash    String      @map("password_hash")
  name            String
  role            String      @default("member") // "member", "coordinator", "admin"
  department      String?
  avatarUrl       String?     @map("avatar_url")
  skills          String      @default("[]") // JSON string array of skills
  totalXp         Int         @default(0) @map("total_xp")
  currentLevel    String      @default("Newcomer") @map("current_level")
  portfolioPublic Boolean     @default(true) @map("portfolio_public")
  createdAt       DateTime    @default(now()) @map("created_at")

  contributions         Contribution[]         @relation("UserContributions")
  reviewedContributions Contribution[]         @relation("ReviewerContributions")
  userBadges            UserBadge[]
  clarificationMessages ClarificationMessage[]
  auditLogs             AuditLog[]

  @@map("users")
}

model Category {
  id          String   @id @default(uuid())
  name        String   @unique
  baseXp      Int
  colorHex    String   @map("color_hex")
  isActive    Boolean  @default(true) @map("is_active")

  contributions Contribution[]

  @@map("categories")
}

model Contribution {
  id               String   @id @default(uuid())
  userId           String   @map("user_id")
  categoryId       String   @map("category_id")
  title            String
  description      String
  projectEventName String   @map("project_event_name")
  evidenceType     String   @map("evidence_type") // "url", "file", "github"
  evidenceUrl      String   @map("evidence_url")
  status           String   @default("pending") // "draft", "pending", "verified", "rejected", "clarification"
  pointsAwarded    Int      @default(0) @map("points_awarded")
  reviewerId       String?  @map("reviewer_id")
  reviewerNotes    String?  @map("reviewer_notes")
  createdAt        DateTime @default(now()) @map("created_at")
  verifiedAt       DateTime? @map("verified_at")

  user                  User                   @relation("UserContributions", fields: [userId], references: [id], onDelete: Cascade)
  reviewer              User?                  @relation("ReviewerContributions", fields: [reviewerId], references: [id])
  category              Category               @relation(fields: [categoryId], references: [id])
  clarificationMessages ClarificationMessage[]

  @@map("contributions")
}

model ClarificationMessage {
  id             String   @id @default(uuid())
  contributionId String   @map("contribution_id")
  senderId       String   @map("sender_id")
  message        String
  createdAt      DateTime @default(now()) @map("created_at")

  contribution Contribution @relation(fields: [contributionId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@map("clarification_messages")
}

model Badge {
  id                String   @id @default(uuid())
  name              String
  description       String
  iconKey           String   @map("icon_key")
  criteriaType      String   @map("criteria_type") // "xp_threshold", "count_category", "streak"
  criteriaThreshold Int      @map("criteria_threshold")

  userBadges UserBadge[]

  @@map("badges")
}

model UserBadge {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  badgeId    String   @map("badge_id")
  unlockedAt DateTime @default(now()) @map("unlocked_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge Badge @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
  @@map("user_badges")
}

model AuditLog {
  id           String   @id @default(uuid())
  actorId      String   @map("actor_id")
  action       String
  targetEntity String   @map("target_entity")
  targetId     String?  @map("target_id")
  payload      String?  // JSON stringified payload
  createdAt    DateTime @default(now()) @map("created_at")

  actor User @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@map("audit_logs")
}
